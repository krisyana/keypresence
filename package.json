{
  "name": "keypresence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Location-verified check-in/out (attendance and more) with daily signed QR per site, admin CMS and a guard-railed AI layer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/server/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "jobs:run": "tsx --env-file-if-exists=.env src/server/cli.ts jobs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/keypresence_test} vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}