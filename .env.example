# Copy to .env. Never commit .env.
# Postgres URL. Leave empty to use embedded PGlite in ./.data (zero setup).
DATABASE_URL=
# Public URL of the app. Used in QR links, CORS/Origin checks and the Secure cookie flag.
APP_URL=http://localhost:5173
PORT=8787
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_SECRET=change-me-change-me-change-me-change-me
# Run background jobs inside the server every 60 s (set 0 to disable and use `npm run jobs:run`).
JOBS_IN_PROCESS=1
# Optional LLM planner for the AI layer. Default is the offline rule-based planner.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
